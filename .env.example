# FSM Zugangsdaten
FSM_EMAIL=deine-email@fahrschule.de
FSM_PASSWORD=dein-passwort
FSM_BASE_URL=https://api.fahrschulmanager.de

# Gateway Konfiguration
GATEWAY_PORT=8090
GATEWAY_API_KEY=geheimer-interner-api-key-optional
DASHBOARD_PASSWORD=geheimes-dashboard-passwort-fuer-den-browser
CACHE_TTL_SECONDS=300
LOG_LEVEL=info

# Optional VoidAuth SSO für das Monitoring Dashboard
# VOIDAUTH_CLIENT_ID=
# VOIDAUTH_CLIENT_SECRET=
# VOIDAUTH_ISSUER_URL=https://auth.arbeits-zimmer.de/oidc
# VOIDAUTH_REDIRECT_URI=https://fsm.arbeits-zimmer.de/dashboard/auth/sso/callback


